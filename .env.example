# ============================================
# CONFIGURACIÓN DE SUPABASE
# ============================================
# 
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a ".env.local"
# 2. Ve a tu proyecto en Supabase Dashboard
# 3. Navega a: Settings > API
# 4. Copia tus credenciales reales y pégalas abajo
# 
# IMPORTANTE:
# - .env.local NO se subirá a Git (está en .gitignore)
# - NUNCA compartas tu SERVICE_ROLE_KEY públicamente
# - Las variables NEXT_PUBLIC_* son públicas (se exponen al navegador)
# 
# ============================================

# URL de tu proyecto Supabase
# Ejemplo: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Anon Key (Pública - segura para usar en el frontend)
# Esta key está protegida por Row Level Security (RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service Role Key (SECRETA - NUNCA expongas en el frontend)
# Solo usar en Server Actions, API Routes, o scripts del servidor
# Esta key bypasea RLS, úsala con extremo cuidado
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Site URL (for email redirects and callbacks)
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base pública de los videos (R2). Cada película guarda solo su ruta (movies/<slug>/master.m3u8)
NEXT_PUBLIC_VIDEO_BASE_URL=https://pub-xxxxxxxx.r2.dev
