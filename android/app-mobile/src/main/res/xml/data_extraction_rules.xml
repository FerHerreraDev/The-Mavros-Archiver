<?xml version="1.0" encoding="utf-8"?>
<!-- La sesión NO se respalda en la nube ni se copia a otro dispositivo -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
