<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Mavros" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF030303</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Mavros.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF030303</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Mavros</item>
    </style>
</resources>
